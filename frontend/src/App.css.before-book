@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', sans-serif;
  background: #f5f1e8;
  color: #171717;
}

button,
a {
  font-family: inherit;
}

.page {
  min-height: 100vh;
  overflow: hidden;
}

/* NAVIGATION */

.navbar {
  height: 86px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 21px;
  font-weight: 800;
}

.brand-logo {
  width: 34px;
  height: 34px;
  border: 3px solid #ffffff;
  background: #172d3a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21px;
  font-weight: 900;
  border-radius: 7px;
  box-shadow: inset 0 0 0 2px #172d3a;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 38px;
}

.nav-links a {
  color: #333;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
}

.nav-button {
  border: 1px solid #222;
  background: transparent;
  padding: 11px 22px;
  border-radius: 100px;
  cursor: pointer;
  font-weight: 600;
}

/* HERO */

.hero {
  min-height: calc(100vh - 170px);
  padding: 6vh 7% 4vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 40px;
}

.hero-content {
  max-width: 650px;
}

.eyebrow {
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 4px;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(55px, 7vw, 105px);
  line-height: 0.9;
  letter-spacing: -5px;
  font-weight: 900;
}

.hero-highlight {
  color: #d62828;
}

.hero-description {
  margin-top: 32px;
  font-size: 19px;
  line-height: 1.65;
  color: #555;
}

.primary-button {
  margin-top: 32px;
  padding: 16px 28px;
  border: none;
  border-radius: 100px;
  background: #171717;
  color: white;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.25s ease;
}

.primary-button:hover {
  transform: translateY(-3px);
}

.primary-button span {
  margin-left: 12px;
}

/* BOOK */

.book-stage {
  min-height: 470px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  perspective: 1200px;
}

.book {
  width: 260px;
  height: 350px;
  position: relative;
  transform: rotateY(-20deg) rotateX(8deg) rotateZ(2deg);
  transform-style: preserve-3d;
  animation: floatBook 4s ease-in-out infinite;
}

.book-cover {
  position: absolute;
  inset: 0;
  background: #171717;
  color: white;
  border-radius: 8px 18px 18px 8px;
  box-shadow: 25px 30px 50px rgba(0, 0, 0, 0.22);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 35px;
  font-size: 27px;
}

.book-cover strong {
  font-size: 43px;
}

.book-pages {
  position: absolute;
  width: 235px;
  height: 325px;
  right: -12px;
  top: 12px;
  background: #fffdf7;
  border-radius: 3px 14px 14px 3px;
  transform: translateZ(-8px);
}

.book-shadow {
  position: absolute;
  width: 300px;
  height: 50px;
  background: rgba(0, 0, 0, 0.15);
  filter: blur(25px);
  bottom: 45px;
  transform: rotate(-5deg);
}

.book-label {
  position: absolute;
  bottom: 15px;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 700;
  color: #777;
}

@keyframes floatBook {
  0%, 100% {
    transform: rotateY(-20deg) rotateX(8deg) rotateZ(2deg) translateY(0);
  }

  50% {
    transform: rotateY(-20deg) rotateX(8deg) rotateZ(2deg) translateY(-15px);
  }
}

/* STATS */

.stats {
  margin: 0 7%;
  padding: 25px 0 35px;
  border-top: 1px solid #d5d0c5;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.stat strong {
  font-size: 23px;
}

.stat span {
  font-size: 13px;
  color: #777;
}

/* MOBILE */

@media (max-width: 800px) {
  .navbar {
    padding: 0 5%;
  }

  .nav-links {
    gap: 15px;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 5vh 5%;
    text-align: center;
  }

  .hero-description {
    font-size: 17px;
  }

  .book-stage {
    min-height: 390px;
  }

  .stats {
    margin: 0 5%;
  }

  h1 {
    letter-spacing: -3px;
  }
}
