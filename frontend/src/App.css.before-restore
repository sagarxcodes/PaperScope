@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', sans-serif;
  background: #f5f1e8;
  color: #171717;
}

button,
a {
  font-family: inherit;
}

.page {
  min-height: 100vh;
  overflow: hidden;
}

/* NAVIGATION */

.navbar {
  height: 86px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 21px;
  font-weight: 800;
}

.brand-logo {
  width: 34px;
  height: 34px;
  border: 3px solid #ffffff;
  background: #172d3a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21px;
  font-weight: 900;
  border-radius: 7px;
  box-shadow: inset 0 0 0 2px #172d3a;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 38px;
}

.nav-links a {
  color: #333;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
}

.nav-button {
  border: 1px solid #171717;
  background: #171717;
  color: #ffffff;
  padding: 11px 22px;
  border-radius: 100px;
  cursor: pointer;
  font-weight: 600;
}

/* HERO */

.hero {
  min-height: calc(100vh - 170px);
  padding: 6vh 7% 4vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 40px;
}

.hero-content {
  max-width: 650px;
}

.eyebrow {
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 4px;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(55px, 7vw, 105px);
  line-height: 0.9;
  letter-spacing: -5px;
  font-weight: 900;
}

.hero-highlight {
  color: #d62828;
}

.hero-description {
  margin-top: 32px;
  font-size: 19px;
  line-height: 1.65;
  color: #555;
}

.primary-button {
  margin-top: 32px;
  padding: 16px 28px;
  border: none;
  border-radius: 100px;
  background: #171717;
  color: white;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.25s ease;
}

.primary-button:hover {
  transform: translateY(-3px);
}

.primary-button span {
  margin-left: 12px;
}

/* BOOK */

.book-stage {
  min-height: 470px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  perspective: 1800px;
  transform: translateX(45px);
}

.real-book {
  width: 275px;
  height: 365px;
  position: relative;
  transform-style: preserve-3d;
  transform: rotateY(-25deg) rotateX(7deg) rotateZ(2deg);
  animation: bookFloat 5s ease-in-out infinite;
}

.book-front-cover,
.book-back-cover,
.book-paper-stack,
.book-page {
  position: absolute;
  width: 275px;
  height: 365px;
  top: 0;
  left: 0;
  transform-style: preserve-3d;
  transform-origin: left center;
  border-radius: 5px 17px 17px 5px;
}

/* Physical back cover */
.book-back-cover {
  background: #111111;
  transform: translateZ(-16px);
  box-shadow: 15px 20px 30px rgba(0, 0, 0, 0.25);
}

/* Visible thickness of the paper block */
.book-paper-stack {
  width: 257px;
  height: 345px;
  left: 9px;
  top: 10px;
  background:
    repeating-linear-gradient(
      to bottom,
      #fffdf7 0px,
      #fffdf7 3px,
      #dedbd2 4px,
      #fffdf7 5px
    );
  transform: translateZ(-4px);
  box-shadow: inset -8px 0 12px rgba(0, 0, 0, 0.08);
}

/* Pages */
.book-page {
  background: #fffdf7;
  color: #171717;
  padding: 35px;
  backface-visibility: hidden;
  box-shadow:
    2px 0 5px rgba(0, 0, 0, 0.08),
    inset -8px 0 14px rgba(0, 0, 0, 0.04);
}

.book-page::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 27px,
      rgba(0, 0, 0, 0.025) 28px
    );
  pointer-events: none;
}

.book-page-1 {
  z-index: 4;
  transform: translateZ(5px) rotateY(0deg);
  animation: turnPage1 10s ease-in-out infinite;
}

.book-page-2 {
  z-index: 3;
  transform: translateZ(3px) rotateY(0deg);
  animation: turnPage2 10s ease-in-out infinite;
}

.book-page-3 {
  z-index: 2;
  transform: translateZ(1px) rotateY(0deg);
  animation: turnPage3 10s ease-in-out infinite;
}

.page-inner {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.page-number {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 10px;
  letter-spacing: 2px;
  color: #999;
}

.page-inner h2 {
  font-size: 30px;
  line-height: 1.05;
  letter-spacing: -1.5px;
}

.page-inner h3 {
  font-size: 18px;
  letter-spacing: 1px;
  line-height: 1.2;
}

.page-inner p {
  margin-top: 12px;
  color: #666;
  font-size: 14px;
  line-height: 1.5;
}

.page-inner strong {
  margin-top: 20px;
  font-size: 16px;
  line-height: 1.4;
}

.page-line {
  width: 65px;
  height: 3px;
  margin-top: 24px;
  background: #d62828;
}

.center-page {
  text-align: center;
  align-items: center;
}

.center-page strong {
  font-size: 28px;
  color: #d62828;
}

/* Front cover */
.book-front-cover {
  z-index: 10;
  background: #171717;
  color: white;
  padding: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  backface-visibility: hidden;
  box-shadow:
    20px 25px 45px rgba(0, 0, 0, 0.27),
    inset -7px 0 10px rgba(255, 255, 255, 0.035);
  transform: translateZ(15px);
  animation: openCover 10s ease-in-out infinite;
}

.book-front-cover::before {
  content: "";
  position: absolute;
  left: 13px;
  top: 0;
  bottom: 0;
  width: 3px;
  background: #d62828;
  opacity: 0.9;
}

.cover-inner {
  text-align: center;
  transform: translateZ(3px);
}

.cover-small {
  display: block;
  font-size: 9px;
  letter-spacing: 3px;
  color: #aaa;
  margin-bottom: 25px;
}

.cover-inner h2 {
  font-size: 36px;
  letter-spacing: -1.5px;
  margin-bottom: 20px;
}

.cover-main {
  font-size: 10px;
  letter-spacing: 2.5px;
  line-height: 1.7;
  color: #d6d6d6;
}

.book-spine {
  position: absolute;
  width: 25px;
  height: 365px;
  left: -5px;
  top: 0;
  background: #111111;
  transform: rotateY(90deg) translateZ(-12px);
  transform-origin: left center;
}

/* Realistic page sequence:
   closed -> open -> page 1 -> page 2 -> page 3 -> close */
@keyframes openCover {
  0%, 10% {
    transform: translateZ(15px) rotateY(0deg);
  }

  20%, 82% {
    transform: translateZ(15px) rotateY(-155deg);
  }

  92%, 100% {
    transform: translateZ(15px) rotateY(0deg);
  }
}

@keyframes turnPage1 {
  0%, 24% {
    transform: translateZ(5px) rotateY(0deg);
  }

  34%, 58% {
    transform: translateZ(5px) rotateY(-170deg);
  }

  68%, 100% {
    transform: translateZ(5px) rotateY(-170deg);
  }
}

@keyframes turnPage2 {
  0%, 38% {
    transform: translateZ(3px) rotateY(0deg);
  }

  48%, 68% {
    transform: translateZ(3px) rotateY(-170deg);
  }

  78%, 100% {
    transform: translateZ(3px) rotateY(-170deg);
  }
}

@keyframes turnPage3 {
  0%, 52% {
    transform: translateZ(1px) rotateY(0deg);
  }

  62%, 78% {
    transform: translateZ(1px) rotateY(-170deg);
  }

  88%, 100% {
    transform: translateZ(1px) rotateY(-170deg);
  }
}

@keyframes bookFloat {
  0%, 100% {
    transform: rotateY(-25deg) rotateX(7deg) rotateZ(2deg) translateY(0);
  }

  50% {
    transform: rotateY(-21deg) rotateX(6deg) rotateZ(2deg) translateY(-12px);
  }
}

.book-shadow {
  position: absolute;
  width: 300px;
  height: 48px;
  background: rgba(0, 0, 0, 0.15);
  filter: blur(25px);
  bottom: 45px;
  transform: rotate(-5deg);
  animation: shadowBook 5s ease-in-out infinite;
}

@keyframes shadowBook {
  0%, 100% {
    transform: rotate(-5deg) scaleX(1);
  }

  50% {
    transform: rotate(-5deg) scaleX(0.82);
  }
}

.book-label {
  position: absolute;
  bottom: 15px;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 700;
  color: #777;
}

/* STATS */

.stats {
  margin: 0 7%;
  padding: 25px 0 35px;
  border-top: 1px solid #d5d0c5;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.stat strong {
  font-size: 23px;
}

.stat span {
  font-size: 13px;
  color: #777;
}

/* MOBILE */

@media (max-width: 800px) {
  .navbar {
    padding: 0 5%;
  }

  .nav-links {
    gap: 15px;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 5vh 5%;
    text-align: center;
  }

  .hero-description {
    font-size: 17px;
  }

  .book-stage {
    min-height: 390px;
  }

  .stats {
    margin: 0 5%;
  }

  h1 {
    letter-spacing: -3px;
  }
}


/* PaperScope book refinements */
.book-page-1 .page-inner h2 {
  color: #d62828;
}

.book-page-1 .page-inner p {
  color: #2563eb;
}

.book-page-2 .page-inner h3 {
  color: #2563eb;
}

.book-page-2 .page-inner h2 {
  color: #d62828;
}

.book-page-2 .page-inner strong {
  color: #16a34a;
}

.book-page-3 .page-inner h2 {
  color: #16a34a;
}

.book-page-3 .page-inner p {
  color: #2563eb;
}

.book-page-3 .page-inner strong {
  color: #d62828;
}

/* Keep the closed cover unmistakably black */
.book-front-cover {
  background: #171717 !important;
  color: #ffffff;
  border: 1px solid #0d0d0d;
}

/* Prevent the colorful page text from inheriting white */
.book-page .page-inner {
  color: #171717;
}

/* Keep the book inside the visual area on smaller screens */
@media (max-width: 800px) {
  .book-stage {
    transform: translateX(0);
  }

  .real-book {
    transform: rotateY(-25deg) rotateX(7deg) rotateZ(2deg);
  }
}


/* Fix front-cover backside: text must disappear with the cover */
.book-front-cover,
.book-front-cover .cover-inner {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* Solid dark inside of the physical cover */
.book-front-cover::after {
  content: "";
  position: absolute;
  inset: 0;
  background: #171717;
  border-radius: inherit;
  transform: translateZ(-1px);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  pointer-events: none;
}

.book-front-cover .cover-inner {
  position: relative;
  z-index: 2;
}

/* =========================================================
   PAPERSCOPE — ABOUT + FOOTER
   Existing hero/login design remains untouched.
   ========================================================= */

.about-section {
  padding: 120px 7% 110px;
  background: #f5f1e8;
  border-top: 1px solid #d5d0c5;
}

.about-heading {
  max-width: 900px;
  margin-bottom: 85px;
}

.about-eyebrow {
  margin: 0 0 18px;
  color: #d62828;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 3px;
}

.about-heading h2 {
  margin: 0;
  color: #171717;
  font-size: clamp(42px, 6vw, 76px);
  line-height: 0.98;
  letter-spacing: -3px;
}

.about-heading h2 span {
  color: #d62828;
}

.about-content {
  max-width: 1150px;
  border-top: 1px solid #cfc8bb;
}

.about-block {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 45px;
  padding: 48px 0;
  border-bottom: 1px solid #cfc8bb;
}

.about-number {
  color: #d62828;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 2px;
}

.about-block h3 {
  margin: 0 0 18px;
  color: #171717;
  font-size: 30px;
  letter-spacing: -1px;
}

.about-block p {
  max-width: 850px;
  margin: 0 0 14px;
  color: #555;
  font-size: 16px;
  line-height: 1.75;
}

.about-block ul {
  margin: 22px 0 0;
  padding-left: 20px;
  color: #555;
  line-height: 2;
}

.about-block li::marker {
  color: #d62828;
}

.site-footer {
  background: #171717;
  color: #f5f1e8;
}

.footer-main {
  min-height: 260px;
  padding: 65px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 50px;
}

.footer-quote {
  position: relative;
  padding-left: 38px;
}

.quote-mark {
  position: absolute;
  left: 0;
  top: -13px;
  color: #d62828;
  font-size: 52px;
  line-height: 1;
}

.footer-quote p {
  margin: 0;
  color: #f5f1e8;
  font-size: 20px;
  line-height: 1.6;
  font-weight: 600;
}

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-align: right;
}

.footer-contact span {
  color: #d62828;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 3px;
}

.footer-contact a {
  color: #f5f1e8;
  font-size: 18px;
  font-weight: 700;
  text-decoration: none;
}

.footer-contact a:hover {
  color: #d62828;
}

.sih-footer {
  width: 100%;
  padding: 22px 7%;
  border-top: 1px solid #383838;
  color: #f5f1e8;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 2.5px;
  text-align: center;
}

/* Responsive */
@media (max-width: 700px) {
  .about-section {
    padding: 80px 5%;
  }

  .about-heading {
    margin-bottom: 55px;
  }

  .about-heading h2 {
    letter-spacing: -2px;
  }

  .about-block {
    grid-template-columns: 1fr;
    gap: 15px;
    padding: 35px 0;
  }

  .footer-main {
    padding: 55px 5%;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-contact {
    text-align: left;
  }

  .sih-footer {
    padding: 20px 5%;
    font-size: 10px;
    letter-spacing: 1.5px;
  }
}
