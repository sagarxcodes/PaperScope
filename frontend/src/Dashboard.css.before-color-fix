* {
  box-sizing: border-box;
}

.dashboard-page {
  min-height: 100vh;
  background: #f5f0e7;
  color: #151515;
}

.dashboard-nav {
  height: 76px;
  padding: 0 6vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #d8d0c3;
  background: #f5f0e7;
}

.dashboard-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  letter-spacing: -0.03em;
  font-size: 20px;
}

.brand-logo {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  background: #151515;
  color: #f5f0e7;
  font-weight: 900;
}

.dashboard-nav-right {
  display: flex;
  align-items: center;
  gap: 24px;
}

.dashboard-status,
.section-label,
.dashboard-eyebrow {
  font-size: 10px;
  letter-spacing: .16em;
  font-weight: 800;
}

.dashboard-nav button,
.footer-column button {
  border: 0;
  background: none;
  cursor: pointer;
  font: inherit;
}

.dashboard-nav button {
  font-weight: 700;
}

.dashboard-content {
  width: min(1180px, 88%);
  margin: auto;
  padding: 70px 0 100px;
}

.dashboard-welcome {
  margin-bottom: 70px;
}

.dashboard-welcome h1 {
  font-size: clamp(44px, 7vw, 82px);
  line-height: .95;
  letter-spacing: -.055em;
  margin: 15px 0 30px;
}

.learning-profile {
  display: inline-flex;
  flex-direction: column;
  gap: 7px;
  padding: 15px 20px;
  border-left: 3px solid #d22d22;
  background: #ebe4d8;
}

.learning-profile span {
  font-size: 9px;
  letter-spacing: .15em;
  font-weight: 800;
}

.upload-section,
.stand-section,
.competency-section,
.gap-section,
.personalized-section,
.igot-section {
  margin-top: 60px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  margin-bottom: 25px;
}

.section-heading h2,
.stand-section h2,
.gap-section h2,
.personalized-section h2,
.igot-section h2 {
  font-size: clamp(30px, 4vw, 50px);
  letter-spacing: -.045em;
  line-height: 1;
  margin: 10px 0 15px;
}

.upload-box {
  border: 1px dashed #9d9384;
  min-height: 300px;
  padding: 45px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #eee7dc;
}

.upload-icon {
  font-size: 42px;
  margin-bottom: 10px;
}

.upload-box h3 {
  font-size: 25px;
  margin: 8px 0;
}

.upload-box p {
  max-width: 600px;
  color: #5f5a52;
}

.hidden-file-input {
  display: none;
}

.upload-button,
.red-button,
.outline-button,
.demo-button {
  padding: 14px 22px;
  font-weight: 800;
  cursor: pointer;
  font-size: 13px;
  letter-spacing: .02em;
}

.upload-button {
  background: #151515;
  color: #f5f0e7;
  border: 1px solid #151515;
  margin: 15px 0;
}

.red-button {
  background: #d52f27;
  color: white;
  border: 1px solid #d52f27;
}

.outline-button {
  background: transparent;
  color: #151515;
  border: 1px solid #151515;
}

.demo-button {
  background: transparent;
  border: 1px solid #9d9384;
  margin-top: 12px;
}

.analyse-button {
  margin-top: 10px;
}

.selected-file {
  margin: 12px 0;
  font-size: 13px;
}

.upload-box small {
  margin-top: 18px;
  color: #716b62;
}

.analysis-statement {
  margin-top: 20px;
  padding: 20px;
  background: #ebe4d8;
  border-left: 3px solid #151515;
}

.error-box {
  border-left-color: #d52f27;
}

.stand-section {
  padding: 60px;
  background: #171717;
  color: #f5f0e7;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 45px;
}

.stand-section p {
  color: #bdb6aa;
  max-width: 600px;
  line-height: 1.7;
}

.stand-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  align-self: center;
}

.stand-metrics div {
  border-left: 1px solid #625e57;
  padding-left: 18px;
}

.stand-metrics strong {
  display: block;
  font-size: 28px;
}

.stand-metrics span {
  display: block;
  margin-top: 8px;
  font-size: 9px;
  letter-spacing: .13em;
  color: #aaa399;
}

.dashboard-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin: 32px 0 70px;
}

.intelligence-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 70px;
}

.intelligence-card {
  padding: 30px;
  border: 1px solid #d2c9bb;
  background: #eee7dc;
  min-height: 350px;
}

.intelligence-card h2 {
  font-size: 25px;
  margin: 10px 0 30px;
  letter-spacing: -.03em;
}

.donut-wrap {
  display: flex;
  justify-content: center;
  margin: 20px 0 30px;
}

.donut {
  width: 170px;
  height: 170px;
  border-radius: 50%;
  background: conic-gradient(
    #151515 0 35%,
    #77716a 35% 80%,
    #d52f27 80% 100%
  );
  display: grid;
  place-items: center;
}

.donut::after {
  content: '';
  position: absolute;
}

.donut > div {
  width: 112px;
  height: 112px;
  border-radius: 50%;
  background: #eee7dc;
  display: grid;
  place-items: center;
  align-content: center;
}

.donut strong {
  font-size: 28px;
}

.donut span {
  font-size: 9px;
  letter-spacing: .1em;
}

.legend {
  display: flex;
  flex-direction: column;
  gap: 9px;
  font-size: 11px;
}

.legend i {
  display: inline-block;
  width: 9px;
  height: 9px;
  margin-right: 6px;
}

.legend-strong {
  background: #151515;
}

.legend-developing {
  background: #77716a;
}

.legend-gap {
  background: #d52f27;
}

.weightage-list > div {
  margin: 20px 0;
}

.weightage-list span {
  font-size: 12px;
}

.weightage-list strong {
  float: right;
}

.weightage-list div div {
  clear: both;
  height: 6px;
  background: #d3cabd;
  margin-top: 9px;
}

.weightage-list i {
  display: block;
  height: 100%;
  background: #151515;
}

.difficulty-bars > div {
  display: grid;
  grid-template-columns: 65px 1fr 40px;
  align-items: center;
  gap: 10px;
  margin: 22px 0;
  font-size: 12px;
}

.difficulty-bars i {
  height: 9px;
  background: #151515;
}

.difficulty-bars strong {
  text-align: right;
}

.intelligence-note {
  margin-top: 35px;
  color: #6e685f;
  font-size: 12px;
  line-height: 1.6;
}

.competency-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.competency-card {
  padding: 25px;
  border: 1px solid #d2c9bb;
  background: #eee7dc;
}

.competency-card.strength {
  border-top: 4px solid #151515;
}

.competency-card.gap {
  border-top: 4px solid #d52f27;
}

.competency-card > span {
  font-size: 9px;
  letter-spacing: .13em;
  font-weight: 800;
}

.competency-card h3 {
  min-height: 72px;
  font-size: 19px;
  line-height: 1.1;
}

.progress {
  height: 7px;
  background: #d0c7ba;
  margin: 22px 0 8px;
}

.progress div {
  height: 100%;
  background: #151515;
}

.gap .progress div {
  background: #d52f27;
}

.competency-card > strong {
  font-size: 25px;
}

.competency-card p {
  font-size: 12px;
  line-height: 1.6;
  color: #625d55;
}

.gap-section {
  padding: 55px;
  background: #e8dfd2;
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 50px;
}

.gap-list {
  display: grid;
  gap: 13px;
}

.gap-list div {
  display: grid;
  grid-template-columns: 45px 1fr;
  padding: 20px;
  background: #f5f0e7;
  border-left: 3px solid #d52f27;
}

.gap-list span {
  font-size: 10px;
  font-weight: 800;
}

.gap-list strong {
  font-size: 18px;
}

.gap-list p {
  grid-column: 2;
  margin: 5px 0 0;
  font-size: 12px;
  color: #6b655d;
}

.personalized-section {
  padding: 65px;
  background: #171717;
  color: #f5f0e7;
}

.personalized-section > p:not(.section-label) {
  color: #b9b2a7;
  max-width: 650px;
  line-height: 1.7;
}

.personalized-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 40px 0;
}

.personalized-cards div {
  padding: 25px 18px;
  border: 1px solid #4c4944;
}

.personalized-cards span {
  font-size: 9px;
  letter-spacing: .12em;
  color: #aaa39a;
}

.personalized-cards strong {
  display: block;
  margin: 16px 0;
}

.personalized-cards small {
  color: #d52f27;
}

.igot-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 55px;
  padding: 60px 0;
}

.igot-section > div:first-child p:not(.section-label) {
  color: #625d55;
  line-height: 1.7;
  max-width: 580px;
}

.igot-courses {
  display: grid;
  gap: 16px;
}

.igot-courses article {
  background: #eee7dc;
  border: 1px solid #d2c9bb;
  padding: 28px;
  border-left: 4px solid #d52f27;
}

.igot-courses span {
  font-size: 9px;
  letter-spacing: .14em;
  font-weight: 800;
}

.igot-courses h3 {
  font-size: 21px;
  margin: 12px 0;
}

.igot-courses p {
  color: #625d55;
  line-height: 1.6;
  font-size: 13px;
}

.igot-courses a {
  display: inline-block;
  margin-top: 8px;
  color: #151515;
  font-weight: 800;
  text-decoration: none;
  border-bottom: 1px solid #151515;
  padding-bottom: 3px;
}

.site-footer {
  background: #111;
  color: #f5f0e7;
  padding: 55px 6vw 25px;
}

.footer-main {
  max-width: 1180px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 22px;
}

.footer-logo span {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  background: #f5f0e7;
  color: #111;
  font-weight: 900;
}

.footer-brand p {
  color: #aaa39a;
  max-width: 350px;
  line-height: 1.6;
  font-size: 13px;
}

.footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 11px;
}

.footer-column > span {
  font-size: 9px;
  letter-spacing: .15em;
  color: #aaa39a;
  margin-bottom: 8px;
}

.footer-column button,
.footer-column a {
  color: #f5f0e7;
  text-decoration: none;
  font-size: 12px;
  padding: 0;
}

.footer-column small {
  color: #aaa39a;
  font-size: 11px;
}

.sih-footer {
  max-width: 1180px;
  margin: 50px auto 0;
  padding-top: 20px;
  border-top: 1px solid #393735;
  color: #88827a;
  font-size: 9px;
  letter-spacing: .13em;
}

@media (max-width: 900px) {
  .stand-section,
  .gap-section,
  .igot-section {
    grid-template-columns: 1fr;
  }

  .intelligence-grid,
  .competency-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .personalized-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-main {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .dashboard-content {
    width: 92%;
    padding-top: 40px;
  }

  .dashboard-status {
    display: none;
  }

  .stand-section {
    padding: 30px;
  }

  .stand-metrics {
    grid-template-columns: 1fr;
  }

  .intelligence-grid,
  .competency-grid,
  .personalized-cards,
  .footer-main {
    grid-template-columns: 1fr;
  }

  .dashboard-actions {
    flex-direction: column;
  }

  .dashboard-actions button {
    width: 100%;
  }

  .gap-section,
  .personalized-section {
    padding: 30px;
  }
}
