  margin-top: 15px;
  padding: 11px 16px;
  border-radius: 10px;
  background: #ded5c6;
  border: 1px solid #c6bdad;
  color: #171717;
  font-size: 13px;
  font-weight: 700;
}

.selected-file strong {
  color: #c92525;
}

.dashboard-welcome h1 {
  color: #171717 !important;
}

.learning-profile span {
  color: #5d574e !important;
}

.learning-profile strong {
  color: #171717 !important;
}

.section-heading h2,
.materials-section h2,
.competency-section h2,
.quiz-section h2,
.recommend-section h2,
.igot-section h2 {
  color: #171717 !important;
  font-size: clamp(36px, 4vw, 46px);
  font-weight: 900;
}

.topic-card-header h3,
.quiz-intro h3,
.competency-card h3 {
  color: #171717 !important;
  font-size: 24px;
  font-weight: 900;
}

.analysis-statement {
  color: #f3eee4 !important;
}

.analysis-statement strong {
  color: #f3eee4 !important;
}

.stand-section h2,
.stand-section p:not(.section-label),
.stand-section button {
  color: inherit;
}

.stand-section h2 {
  font-size: clamp(38px, 4.5vw, 55px);
}

.stand-section .red-button {
  color: #f3eee4 !important;
}

.section-label {
  font-size: 14px !important;
  font-weight: 900;
  color: #c92525 !important;
}

.analysis-status {
  color: #171717 !important;
}

.topic-card-header span {
  color: #c92525 !important;
}

.chart-legend span,
.quiz-intro p,
.recommend-section p:not(.section-label),
.igot-section p:not(.section-label),
.competency-card p,
.capacity-card p {
  color: #4f4a43 !important;
  font-size: 14px;
}

.quiz-cards strong {
  color: #171717 !important;
  font-size: 20px;
}

.quiz-cards small {
  color: #514b43 !important;
  font-size: 13px;
}

.recommend-section,
.igot-section {
  min-height: 230px;
}

.recommend-section h2,
.igot-section h2 {
  font-size: clamp(38px, 4.5vw, 52px);
  font-weight: 900;
}

.recommend-section .red-button,
.igot-section .dark-button {
  font-size: 14px;
  padding: 15px 24px;
}

.igot-section .section-label {
  font-size: 16px !important;
}

.dashboard-footer {
  position: relative;
  min-height: 170px;
  padding: 32px 7% 58px;
  background: #0d0c0b !important;
  color: #e7dfd1 !important;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 40px;
}

.footer-quote {
  max-width: 390px;
  color: #e7dfd1 !important;
  font-size: 19px;
  line-height: 1.5;
  font-weight: 700;
}

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 8px;
  text-align: right;
}

.footer-contact strong {
  color: #c92525 !important;
  font-size: 14px;
  letter-spacing: 1.5px;
}

.footer-contact span {
  color: #e7dfd1 !important;
  font-size: 14px;
  font-weight: 600;
}

.footer-sih {
  position: absolute;
  left: 7%;
  right: 7%;
  bottom: 17px;
  color: #9d968c !important;
  text-align: center;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .8px;
  text-transform: uppercase;
}

@media (max-width: 700px) {
  .dashboard-footer {
    min-height: 230px;
    padding: 30px 5% 65px;
    flex-direction: column;
  }

  .footer-contact {
    text-align: left;
  }

  .footer-sih {
    left: 5%;
    right: 5%;
    text-align: left;
    font-size: 9px;
  }
}
