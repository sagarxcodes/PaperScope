.analysis-page {
  min-height: 100vh;
  background: #f5f1e8;
  color: #171717;
}

.analysis-nav {
  height: 78px;
  padding: 0 7%;
  border-bottom: 1px solid #d5d0c5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.analysis-nav button {
  border: 0;
  background: transparent;
  color: #171717;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.analysis-nav strong {
  font-size: 20px;
}

.analysis-content {
  max-width: 1250px;
  margin: auto;
  padding: 65px 7% 90px;
}

.analysis-content h1 {
  margin-top: 12px;
  font-size: clamp(48px, 6vw, 76px);
  letter-spacing: -4px;
}

.section-label {
  color: #d62828;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2px;
}

.analysis-lead {
  max-width: 680px;
  margin-top: 18px;
  color: #666;
  line-height: 1.6;
}

.analysis-summary {
  margin-top: 45px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #171717;
  color: #f5f1e8;
  border-radius: 20px;
  overflow: hidden;
}

.analysis-summary div {
  padding: 28px;
  border-right: 1px solid #393939;
}

.analysis-summary div:last-child {
  border: 0;
}

.analysis-summary span {
  display: block;
  color: #aaa;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.analysis-summary strong {
  display: block;
  margin-top: 7px;
  font-size: 32px;
}

.analysis-panel {
  margin-top: 30px;
  padding: 32px;
  background: #eee8da;
  border: 1px solid #d5d0c5;
  border-radius: 20px;
}

.analysis-panel h2 {
  font-size: 28px;
}

.analysis-panel > p {
  margin-top: 10px;
  color: #666;
  line-height: 1.55;
}

.analysis-table-wrap {
  overflow-x: auto;
  margin-top: 25px;
}

.analysis-table {
  width: 100%;
  border-collapse: collapse;
}

.analysis-table th,
.analysis-table td {
  padding: 15px 10px;
  border-bottom: 1px solid #cbc4b7;
  text-align: left;
  font-size: 12px;
}

.analysis-table th {
  color: #777;
  font-size: 9px;
  letter-spacing: 1px;
}

.analysis-table td:first-child {
  font-weight: 800;
}

.plan-panel h2 {
  margin-top: 9px;
}

.plan-fields {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 25px;
}

.plan-fields label {
  display: grid;
  gap: 7px;
  color: #555;
  font-size: 11px;
  font-weight: 800;
}

.plan-fields select {
  height: 45px;
  border: 1px solid #c8c1b4;
  border-radius: 9px;
  background: #f5f1e8;
  color: #171717;
  padding: 0 10px;
}

.plan-panel button {
  margin-top: 20px;
  border: 0;
  border-radius: 100px;
  background: #d62828;
  color: #f5f1e8;
  padding: 13px 19px;
  font-weight: 800;
  cursor: pointer;
}

.analysis-footer {
  background: #11100f;
  color: #f5f1e8;
  padding: 35px 7%;
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

@media(max-width:700px) {
  .analysis-summary,
  .plan-fields {
    grid-template-columns: 1fr;
  }

  .analysis-summary div {
    border-right: 0;
    border-bottom: 1px solid #393939;
  }

  .analysis-footer {
    flex-direction: column;
    gap: 15px;
  }
}


/* Dedicated analysis page typography */
.analysis-nav button {
  color: #171717 !important;
}

.analysis-nav strong {
  color: #171717 !important;
}

.analysis-content h1,
.analysis-content h2,
.analysis-content h3 {
  color: #171717 !important;
}

.analysis-content .section-label {
  color: #c92525 !important;
  font-size: 14px !important;
  font-weight: 900;
}

.analysis-lead,
.analysis-panel p {
  color: #4f4a43 !important;
}

.analysis-footer {
  background: #0d0c0b !important;
  color: #e7dfd1 !important;
}
