import { useRef, useState } from 'react'
import './Dashboard.css'

const API = 'http://127.0.0.1:8000'

function Dashboard() {
  const fileInputRef = useRef(null)
  const [selectedFile, setSelectedFile] = useState(null)
  const [loading, setLoading] = useState(false)
  const [analysis, setAnalysis] = useState(null)
  const [error, setError] = useState('')

  const user = JSON.parse(
    localStorage.getItem('paperscopeUser') || 'null'
  )

  const name = user?.name || 'Learner'

  const go = (path) => {
    window.location.href = path
  }

  const analyseMaterial = async () => {
    if (!selectedFile) return

    setLoading(true)
    setError('')

    try {
      // Demo mode guarantees a reliable SIH presentation.
      const response = await fetch(`${API}/api/demo/analysis`)

      if (!response.ok) {
        throw new Error('PaperScope demo analysis failed')
      }

      const data = await response.json()

      // Convert demo API structure into dashboard structure.
      const converted = {
        ...data,
        assessment: {
          accuracy: 68
        },
        competency: {
          competency_count: data.competencies?.length || 0,
          readiness: 'Developing',
          competencies: (data.competencies || []).map((item) => ({
            competency: item.name,
            accuracy: item.score,
            level: item.level.toLowerCase(),
            recommendation:
              item.score < 60
                ? 'Priority area for targeted learning and practice.'
                : item.score < 75
                  ? 'Continue practice to strengthen this competency.'
                  : 'Strong competency. Maintain through periodic practice.'
          }))
        }
      }

      localStorage.setItem(
        'paperscope_analysis',
        JSON.stringify(converted)
      )

      localStorage.setItem(
        'paperscope_material',
        selectedFile.name
      )

      setAnalysis(converted)
    } catch (err) {
      setError(err.message || 'Unable to analyse material')
    } finally {
      setLoading(false)
    }
  }

  const competency =
    analysis?.competency?.competencies || []

  const overallAccuracy =
    analysis?.assessment?.accuracy ?? 0

  return (
    <main className="dashboard-page">
      <nav className="dashboard-nav">
        <div className="dashboard-brand">
          <span className="brand-logo">P</span>
          <span>PaperScope</span>
        </div>

        <div className="dashboard-nav-right">
          <span className="dashboard-status">
            AI-POWERED COMPETENCY INTELLIGENCE
          </span>

          <button
            onClick={() => {
              localStorage.removeItem('paperscopeLoggedIn')
              window.location.href = '/'
            }}
          >
            Logout
          </button>
        </div>
      </nav>

      <section className="dashboard-content">

        <header className="dashboard-welcome">
          <p className="dashboard-eyebrow">
            PAPERSCOPE LEARNING INTELLIGENCE
          </p>

          <h1>Welcome, {name}.</h1>

          <div className="learning-profile">
            <span>LEARNING PROFILE</span>
            <strong>
              Official Statistics &amp; Data Analyst
            </strong>
          </div>
        </header>

        <section className="upload-section">
          <div className="section-heading">
            <div>
              <p className="section-label">LEARNING MATERIAL</p>
              <h2>Upload Learning Material</h2>
            </div>
          </div>

          <div className="upload-box">
            <div className="upload-icon">+</div>

            <h3>Drop your learning material here</h3>

            <p>
              Upload documents, presentations, text files or images
              for PaperScope to understand.
            </p>

            <input
              ref={fileInputRef}
              type="file"
              className="hidden-file-input"
              accept=".pdf,.doc,.docx,.txt,.ppt,.pptx,.jpeg,.jpg,.png"
              onChange={(e) => {
                const file = e.target.files?.[0]
                if (file) setSelectedFile(file)
              }}
            />

            <button
              className="upload-button"
              type="button"
              onClick={() => fileInputRef.current?.click()}
            >
              Choose Material
            </button>

            {selectedFile && (
              <>
                <div className="selected-file">
                  <strong>Selected material:</strong>{' '}
                  {selectedFile.name}
                </div>

                <button
                  className="red-button"
                  type="button"
                  onClick={analyseMaterial}
                  disabled={loading}
                >
                  {loading
                    ? 'PaperScope is analysing...'
                    : 'Analyse with PaperScope →'}
                </button>
              </>
            )}

            <small>
              Supported formats: PDF, DOC, DOCX, TXT, PPT, PPTX,
              JPEG, JPG, PNG
            </small>
          </div>

          {error && (
            <div className="analysis-statement">
              {error}
            </div>
          )}

          {!analysis && !error && (
            <div className="analysis-statement">
              <strong>
                PaperScope will analyse concepts, map competencies,
                detect gaps, generate MCQs and recommend targeted
                learning.
              </strong>
            </div>
          )}
        </section>

        {analysis && (
          <>
            <section className="stand-section">
              <div>
                <p className="section-label">WHERE YOU STAND</p>

                <h2>
                  Your current capability,
                  <br />
                  understood by PaperScope.
                </h2>

                <p>
                  PaperScope has evaluated your learning intelligence
                  and identified your current competency position.
                </p>
              </div>

              <div className="stand-metrics">
                <div>
                  <strong>{overallAccuracy}%</strong>
                  <span>OVERALL CAPACITY</span>
                </div>

                <div>
                  <strong>
                    {analysis.competency?.competency_count || 0}
                  </strong>
                  <span>COMPETENCIES</span>
                </div>

                <div>
                  <strong>
                    {analysis.competency?.readiness || '—'}
                  </strong>
                  <span>READINESS</span>
                </div>
              </div>

              <button
                className="red-button"
                onClick={() => go('/analysis')}
              >
                View Complete Analysis →
              </button>

              <button
                className="red-button"
                onClick={() => go('/quiz')}
              >
                Start Adaptive Quiz →
              </button>

              <button
                className="red-button"
                onClick={() => go('/recommended')}
              >
                View Learning Recommendations →
              </button>
            </section>

            <section className="competency-section">
              <div className="section-heading">
                <div>
                  <p className="section-label">
                    COMPETENCY INTELLIGENCE
                  </p>

                  <h2>What are you good at?</h2>
                </div>
              </div>

              <div className="competency-grid">
                {competency.map((item) => (
                  <div
                    key={item.competency}
                    className={`competency-card ${
                      item.level === 'strong'
                        ? 'strength'
                        : 'gap'
                    }`}
                  >
                    <span>
                      {item.level === 'strong'
                        ? 'STRENGTH'
                        : 'COMPETENCY GAP'}
                    </span>

                    <h3>{item.competency}</h3>

                    <div className="progress">
                      <div
                        style={{
                          width: `${Math.max(
                            0,
                            Math.min(100, item.accuracy)
                          )}%`,
                        }}
                      />
                    </div>

                    <strong>
                      {item.accuracy}%
                    </strong>

                    <p>
                      {item.recommendation}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          </>
        )}
      </section>
    </main>
  )
}

export default Dashboard
